    "@capacitor/status-bar": "^8.0.4",
    "express": "^5.2.1",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/express": "^5.0.6",
