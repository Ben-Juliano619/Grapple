# Local development automatically uses http://localhost:3001 for sockets.
# Production frontend uses NEXT_PUBLIC_SOCKET_URL (with app fallback if unset).
# Set NEXT_PUBLIC_USE_LOCAL_SOCKET=true to force localhost for debugging in any environment.
NEXT_PUBLIC_SOCKET_URL=
NEXT_PUBLIC_USE_LOCAL_SOCKET=
CLIENT_URL=
PORT=
# Game server abuse limits (per IP / per connection). Raise temporarily for load or
# pen testing from a single machine, e.g. RATE_LIMIT_MULTIPLIER=100. Default 1.
RATE_LIMIT_MULTIPLIER=
# Use X-Forwarded-For for client IPs (defaults to true in production, e.g. behind Railway).
TRUST_PROXY=
