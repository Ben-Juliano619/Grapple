# Frontend/public networking.
# Leave blank to auto-resolve based on current browser host.
# During local dev from http://<LAN_IP>:3000 these infer http://<LAN_IP>:3001.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SOCKET_URL=

# Backend settings.
# Comma-separated list of allowed frontend origins for CORS.
# Examples:
# CLIENT_URL=http://localhost:3000,http://192.168.1.25:3000,https://your-domain.com
CLIENT_URL=
PORT=3001
