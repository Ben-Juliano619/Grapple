# Optional explicit frontend -> backend URLs.
# If unset, the browser will use same-origin in production and same host + :3001 in dev.
NEXT_PUBLIC_SOCKET_URL=
NEXT_PUBLIC_API_BASE_URL=

# Optional dev override for backend port discovery (defaults to 3001).
NEXT_PUBLIC_BACKEND_PORT=3001

# Server CORS allowlist (comma-separated origins). Recommended in production.
# Example: https://grapplewrestlingcardgame.com,https://www.grapplewrestlingcardgame.com
CLIENT_URL=

# Express + Socket.IO server port.
PORT=3001
